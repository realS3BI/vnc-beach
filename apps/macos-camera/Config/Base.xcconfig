CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 6.0
ENABLE_HARDENED_RUNTIME = YES
// Universal like the Rust binary that replaces the host executable.
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO

// The team comes from the iOS app's local signing file (ignored by Git).
#include? "../../ios/Config/Signing.local.xcconfig"
